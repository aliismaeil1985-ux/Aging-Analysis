rules_version = '2';

/* ============================================================================
   Tania Inventory Dashboard — Firestore Security Rules (استدعاء مضمون)
   قراءة مفتوحة لكل البيانات  +  قفل الكتابة على المدير (لا عبث)
   ----------------------------------------------------------------------------
   • القراءة مفتوحة على كامل قاعدة البيانات → استدعاء فوري مضمون لكل البيانات
     (الحسابات، الحضور، حالة المستخدمين، الشاشات، التقارير) أياً كان اسم
     المجموعة التي يخزّن فيها التطبيق — inventory_dashboard أو user_presence أو
     login_logs أو غيرها — فلن تتعذّر أي قراءة بعد الآن.
   • الكتابة (إضافة/تعديل/حذف) للمدير الحقيقي فقط → منع العبث بالبيانات.
   • استثناء الكتابة: سجلّات الحضور والنشاط يكتبها أي زائر حتى يُسجَّل حضوره.

   لتفعيل قفل الكتابة: Authentication → Email/Password مفعّل + المستخدم
   aliismaeil1985@gmail.com موجود (بكلمة مرور = كلمة مرور المدير في التطبيق).
   ============================================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* المدير الحقيقي = جلسة موثّقة ببريد المدير */
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'aliismaeil1985@gmail.com';
    }

    /* القراءة مفتوحة لكل شيء (استدعاء مضمون) · الكتابة للمدير فقط (لا عبث) */
    match /{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* استثناء الكتابة — سجلّات الحضور والنشاط يكتبها الزوّار
       (تُغطّي كِلا الاحتمالين: مستندات داخل inventory_dashboard، أو مجموعات منفصلة) */
    match /inventory_dashboard/{doc} {
      allow write: if isAdmin() || doc == 'presence' || doc == 'login_log';
    }
    match /user_presence/{docs=**} { allow write: if true; }
    match /login_logs/{docs=**}    { allow write: if true; }
    match /presence/{docs=**}      { allow write: if true; }
    match /login_log/{docs=**}     { allow write: if true; }
  }
}
